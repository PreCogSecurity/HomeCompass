# Copy this file to `.env` and adjust. `.env` is gitignored and must never be
# committed. HomeCompass reads these at boot and refuses to start on a bad value,
# so a typo fails loudly instead of silently weakening the security posture.

# Bind address. Keep 127.0.0.1 unless you intend to reach it from other hosts.
HOST=127.0.0.1
PORT=8080

# development | test | production
NODE_ENV=development

# debug | info | warn | error | silent
LOG_LEVEL=info

# Where the inventory database is written. Created automatically if missing.
DATA_DIR=./data
# Optional explicit database path; defaults to <DATA_DIR>/items.json
# STORE_FILE=./data/items.json

# Static assets served to the browser.
PUBLIC_DIR=./public

# Hard ceiling on stored records (DoS guard against unbounded local growth).
MAX_ITEMS=5000

# Maximum accepted JSON request body, in bytes.
MAX_BODY_BYTES=65536

# Per-client API rate limit (token bucket, in memory).
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL_PER_SECOND=2

# Set to true ONLY when a reverse proxy you control terminates the connection.
# When false, X-Forwarded-For is ignored so clients cannot spoof their identity
# to evade throttling.
TRUST_PROXY=false

# Extra `Host` header values this instance answers for, comma separated. Needed
# only when the app is reached under a real hostname, e.g.
#   ALLOWED_HOSTS=home.example.com
# Loopback names and HOST are always accepted. Setting this to `*` disables the
# DNS-rebinding guard entirely and should never be done on a shared machine.
# ALLOWED_HOSTS=

# Expose GET /api/metrics. Defaults to true outside production and false in
# production, because the counters describe the size and shape of your
# inventory and this service has no authentication.
# METRICS_ENABLED=true

# How long a graceful shutdown may take before the process is forced to exit.
SHUTDOWN_TIMEOUT_MS=10000
